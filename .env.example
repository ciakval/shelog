# shelog environment -- documented EXAMPLE. Copy to the real secrets file (gitignored) and fill in.
#
# The app reads this file from its working directory by itself (no path on the command line).
# Real environment variables override values from the file.

# Shelly Cloud authorization key: Shelly app > User settings > Authorization cloud key.
# It changes when the account password changes. Never commit it, never log it.
SHELLY_AUTH_KEY=

# Shelly Cloud server host shown next to the key (a plain hostname, e.g. shelly-NN-eu.shelly.cloud).
# https:// is stripped; http://, ports, paths and credentials are rejected.
SHELLY_HOST=

# SQLite database (WAL mode); the directory is created on first start.
SHELOG_DB_PATH=data/shelog.db

# Device inventory (see devices.example.toml).
SHELOG_DEVICES_FILE=devices.toml

# Seconds between polls; minimum 30. The Shelly account limit is 1 request/second.
SHELOG_POLL_INTERVAL_S=60

# DEBUG, INFO, WARNING or ERROR.
SHELOG_LOG_LEVEL=INFO
