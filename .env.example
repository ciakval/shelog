# shelog environment -- documented EXAMPLE.
#
# Production: /home/deploy/DOCKER/shelog/.env on Bombur (chmod 600); only the `poller`
# container gets it. Local runs: a gitignored file of this name in the checkout root, which
# the app reads from its working directory by itself. Real environment variables win.

# --- Managed by CI / bombur-onboard ---
GITHUB_REPOSITORY=ciakval/shelog
IMAGE_TAG=latest
CONTAINER_NAME=shelog-web
DEPLOY_ENV=production

# Container user: must own/write ./data on the server (`id deploy` on Bombur).
APP_UID=1002
APP_GID=1002

# --- Shelly Cloud (secrets; fill by hand, left empty so bombur-add-app does not randomize them) ---
# Shelly app > User settings > Authorization cloud key. Changes when the password changes.
SHELLY_AUTH_KEY=
# Server host shown next to the key, e.g. shelly-NN-eu.shelly.cloud (plain hostname).
SHELLY_HOST=

# --- Poller ---
# Seconds between polls; minimum 30, maximum 86400. The account limit is 1 request/second.
SHELOG_POLL_INTERVAL_S=60
# DEBUG, INFO, WARNING or ERROR.
SHELOG_LOG_LEVEL=INFO
# Paths for local runs; compose.yaml overrides both inside the containers.
SHELOG_DB_PATH=data/shelog.db
SHELOG_DEVICES_FILE=devices.toml

# --- Alerts (ntfy). The topic is effectively a password: long and random. ---
NTFY_TOPIC=CHANGE_ME
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
# Optional external dead-man's switch (healthchecks.io ping URL; secret).
# HEALTHCHECK_PING_URL=

# --- Outdoor weather (Open-Meteo). Round to 2 decimals; never commit real values. ---
# SHELOG_LAT=
# SHELOG_LON=
